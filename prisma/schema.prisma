datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique
  name     String @db.VarChar(50)
  username String @db.VarChar(50)
  posts    Post[]
}

model Post {
  id        String  @id @default(uuid()) @db.Uuid
  title     String
  content   String?
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  String  @db.Uuid
}
